    {
      "evidence_id": "E1152-R01",
      "url": "./QX-R3-08_QX-P-001152_单题回执_v01.jsonl",
      "locator": "本note阿贝尔特例完整短证",
      "version": "2026-11-27本轮手工证明及另一核对者独立复核",
